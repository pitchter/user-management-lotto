{
  "info": {
    "name": "User Management API",
    "description": "User management with JWT authentication and RBAC.\n\nRun the folders top to bottom. \"Sign in\" stores the tokens into collection variables, so every later request is authenticated automatically.\n\nStart the service with `make docker-up` first. The admin requests need BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD set in .env.\n\nWorked examples for every response, including errors, are in docs/api-examples.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Captured by \"Sign in as a user\""
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Captured by \"Sign in as the admin\""
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "change-this-password",
      "type": "string"
    },
    {
      "key": "nextCursor",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}/healthz"
              ]
            },
            "description": "Reports that the process is up. Never touches MongoDB.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}/readyz"
              ]
            },
            "description": "Reports whether the service can serve traffic, MongoDB included.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('mongo is up', () => pm.expect(pm.response.json().mongo).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}/api/v1/auth/register"
              ]
            },
            "description": "Public sign-up. The result always has the role \"user\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Somchai Jaidee\",\n  \"email\": \"somchai@example.com\",\n  \"password\": \"secret-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('role is user', () => pm.expect(b.role).to.eql('user'));",
                  "pm.test('no password in the response', () => pm.expect(pm.response.text()).to.not.include('password'));",
                  "pm.collectionVariables.set('userId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a second user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}/api/v1/auth/register"
              ]
            },
            "description": "Gives us somebody else's email to collide with later.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}/api/v1/auth/register"
              ]
            },
            "description": "Enforced by a unique index in MongoDB, not by a pre-check.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Somchai Jaidee\",\n  \"email\": \"somchai@example.com\",\n  \"password\": \"secret-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('EMAIL_TAKEN', () => pm.expect(pm.response.json().error.code).to.eql('EMAIL_TAKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — invalid fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}/api/v1/auth/register"
              ]
            },
            "description": "Every invalid field is reported in one response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "const e = pm.response.json().error;",
                  "pm.test('VALIDATION_ERROR', () => pm.expect(e.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('three fields reported', () => pm.expect(e.details).to.have.lengthOf(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as a user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}/api/v1/auth/login"
              ]
            },
            "description": "Stores the access token in the {{token}} collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"somchai@example.com\",\n  \"password\": \"secret-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Bearer token', () => pm.expect(b.token_type).to.eql('Bearer'));",
                  "pm.test('no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.collectionVariables.set('token', b.access_token);",
                  "pm.collectionVariables.set('userId', b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as the admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}/api/v1/auth/login"
              ]
            },
            "description": "Needs BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD in .env.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('role is admin', () => pm.expect(b.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', b.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in — wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}/api/v1/auth/login"
              ]
            },
            "description": "Compare this response with the next one: they are identical.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"somchai@example.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('invalid email or password', () => pm.expect(pm.response.json().error.message).to.eql('invalid email or password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in — unknown email (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}/api/v1/auth/login"
              ]
            },
            "description": "Deliberately indistinguishable from a wrong password, in both wording and timing, so registered addresses cannot be discovered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('same message as a wrong password', () => pm.expect(pm.response.json().error.message).to.eql('invalid email or password'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}/api/v1/users/me"
              ]
            },
            "description": "The token holder's own record."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no password field', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "My profile — no token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}/api/v1/users/me"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('WWW-Authenticate', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?limit=2",
              "host": [
                "{{baseUrl}}/api/v1/users?limit=2"
              ]
            },
            "description": "Keyset pagination. Stores meta.next_cursor for the next request.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('at most the limit', () => pm.expect(b.data.length).to.be.at.most(2));",
                  "if (b.meta.next_cursor) { pm.collectionVariables.set('nextCursor', b.meta.next_cursor); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List users — next page (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?limit=2&cursor={{nextCursor}}",
              "host": [
                "{{baseUrl}}/api/v1/users?limit=2&cursor={{nextCursor}}"
              ]
            },
            "description": "Uses the cursor captured by the previous request.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users as a plain user (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}/api/v1/users"
              ]
            },
            "description": "The listing exposes every user's email, so it is admin-only."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users — limit=0 (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?limit=0",
              "host": [
                "{{baseUrl}}/api/v1/users?limit=0"
              ]
            },
            "description": "An explicit 0 is a mistake, distinct from omitting the parameter.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a user (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
