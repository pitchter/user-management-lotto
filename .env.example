# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production
# production turns off gin's debug mode and gRPC server reflection.
APP_ENV=development

# ---------------------------------------------------------------------------
# Servers
# ---------------------------------------------------------------------------
HTTP_PORT=8080
GRPC_PORT=50051
# How long in-flight requests are given to finish on shutdown.
SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Running locally:        mongodb://localhost:27017
# Running docker compose: mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=user_management
MONGO_TIMEOUT=10s

# ---------------------------------------------------------------------------
# JWT (HS256)
# ---------------------------------------------------------------------------
# Must be at least 32 bytes long or the application refuses to start.
# Generate one with: openssl rand -base64 48   (or: make secret)
JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-bytes
JWT_ISSUER=user-management-api
JWT_AUDIENCE=user-management-client
JWT_ACCESS_TTL=15m

# ---------------------------------------------------------------------------
# Password hashing
# ---------------------------------------------------------------------------
# bcrypt cost: 10-14. Higher is safer but exponentially slower.
BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Background worker (requirement #6: log the user count every 10 seconds)
# ---------------------------------------------------------------------------
USER_COUNT_INTERVAL=10s

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Bootstrap admin (optional)
# ---------------------------------------------------------------------------
# With both set, the first admin is created on start-up (idempotent).
# Leave them empty to skip it.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
